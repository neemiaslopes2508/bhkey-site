---
// Ícone Phosphor emlinedo SVG do pacote @phosphor-icons/core.
// Sem CDN, sem emoji, sem webfont: o SVG entra no HTML no momento do build.
// Uso:  <Icon name="whatsapp-logo" size={18} />
//       <Icon name="map-pin" size={20} label="Endereço" />
import fs from 'node:fs';
import path from 'node:path';

const { name, weight = 'regular', size = 20, label, class: className = '' } = Astro.props;

const fileName = weight === 'regular' ? `${name}.svg` : `${name}-${weight}.svg`;
const filePath = path.resolve(process.cwd(), 'node_modules/@phosphor-icons/core/assets', weight, fileName);

let inner = '';
try {
  const raw = fs.readFileSync(filePath, 'utf8');
  inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
} catch {
  throw new Error(`[Icon] Ícone Phosphor não encontrado: assets/${weight}/${fileName}`);
}
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label ? <title>{label}</title> : null}
  <Fragment set:html={inner} />
</svg>
