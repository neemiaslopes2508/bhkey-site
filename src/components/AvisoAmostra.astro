---
// Aviso fixo de dado de amostra. Precisa aparecer em catálogo e em produto.
// v3: painel arredondado (16) em superfície, mesma mensagem verde de sempre.
import Icon from './Icon.astro';
const { aviso } = Astro.props;
---
<p
  class="flex items-start gap-3 rounded-lg border border-green/30 bg-green/10 p-4 text-sm text-paper"
  role="note"
>
  <span class="mt-1 shrink-0 text-green"><Icon name="warning" size={18} /></span>
  <span>{aviso}</span>
</p>
