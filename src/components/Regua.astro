---
// Cabeçalho de seção — v3: rótulo mono + tick de acento de 24px + meta mono
// à direita. O fio de largura total do v2 foi removido (a régua inteira era
// parte do look industrial que o v3 troca por respiro e card arredondado).
// O rótulo traz informação nova, não repete o título.
const { esquerda, direita, class: className = '' } = Astro.props;
---
<div class:list={['flex flex-wrap items-center gap-x-3 gap-y-2', className]}>
  <span class="h-0.5 w-6 shrink-0 bg-green" aria-hidden="true"></span>
  <span class="label-caps shrink-0 text-green">{esquerda}</span>
  {direita && (
    <span class="label-caps ml-auto shrink-0 text-paper-dim">{direita}</span>
  )}
</div>
