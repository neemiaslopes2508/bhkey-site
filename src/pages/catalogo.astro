---
import Base from '../layouts/Base.astro';
import Regua from '../components/Regua.astro';
import Icon from '../components/Icon.astro';
import ProdutoCard from '../components/ProdutoCard.astro';
import AvisoAmostra from '../components/AvisoAmostra.astro';
import catalogo from '../data/catalogo.json';
import { prefixFor } from '../lib/paths.js';
import { linkWhatsApp } from '../config/site.js';

const prefix = prefixFor(Astro.url.pathname);
const total = catalogo.itens.length;
const categorias = catalogo.categorias.map((c) => ({
  ...c,
  total: catalogo.itens.filter((i) => i.categoria === c.slug).length,
}));
---
<Base
  title="Catálogo — BH Key Distribuidora"
  description="Catálogo de material para chaveiro: chaves canivete, controles remotos, carcaças e chaves automotivas. Busque por nome ou código e peça pelo WhatsApp."
>
  <section class="border-b border-ink-line">
    <div class="shell py-10 sm:py-12">
      <Regua esquerda="Catálogo" direita={`${total} itens · ${categorias.length} categorias`} />
      <h1 class="mt-6 text-3xl sm:text-4xl lg:text-5xl">Catálogo</h1>
      <p class="mt-4 max-w-[62ch] text-base text-paper-dim">
        Busque por nome ou código, filtre por categoria e monte a lista. Preço sob
        consulta: envie os itens pelo WhatsApp para confirmar disponibilidade e valor.
      </p>

      <div class="mt-8 max-w-[70ch]">
        <AvisoAmostra aviso={catalogo._aviso} />
      </div>

      <!-- Controles: busca + filtro (ligados a src/js/main.js) -->
      <div class="card mt-8 p-4 sm:p-6">
        <div class="flex flex-col gap-6">
          <div>
            <label for="catalogo-busca" class="label-caps mb-2 block text-paper-dim">
              Buscar por nome ou código
            </label>
            <div class="relative">
              <span class="campo-icone" aria-hidden="true">
                <Icon name="magnifying-glass" size={18} />
              </span>
              <input
                id="catalogo-busca"
                type="search"
                name="q"
                autocomplete="off"
                spellcheck="false"
                placeholder="ex.: BK-CR-201 ou controle remoto"
                class="campo"
              />
              <button
                type="button"
                id="catalogo-limpar"
                class="campo-limpar"
                data-busca-limpar
                aria-label="Limpar a busca"
                hidden
              >
                <Icon name="x" size={16} />
              </button>
            </div>
          </div>

          <div>
            <p class="label-caps mb-2 text-paper-dim" id="filtro-rotulo">Filtrar por categoria</p>
            <ul class="flex flex-wrap gap-2" role="group" aria-labelledby="filtro-rotulo">
              <li>
                <button
                  type="button"
                  data-filtro="todos"
                  aria-pressed="true"
                  class="btn-chip"
                >Todos</button>
              </li>
              {categorias.map((c) => (
                <li>
                  <button
                    type="button"
                    data-filtro={c.slug}
                    aria-pressed="false"
                    class="btn-chip"
                  >{c.nome}</button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="text-2xl lg:text-3xl">Itens do catálogo</h2>
        <p
          id="catalogo-contador"
          class="label-caps text-paper-dim"
          aria-live="polite"
        >{total} itens</p>
      </div>

      <!-- Grade: 2 colunas no celular, 3 no tablet, 4 no desktop, respiro 12. -->
      <div
        id="catalogo-grid"
        class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4"
      >
        {catalogo.itens.map((item) => (
          <ProdutoCard item={item} categorias={catalogo.categorias} />
        ))}
      </div>

      <div id="catalogo-vazio" class="card mt-6 hidden px-6 py-12 text-center">
        <p class="text-xl font-bold">Nenhum item encontrado.</p>
        <p class="mx-auto mt-4 max-w-[46ch] text-sm text-paper-dim">
          Tente outro termo, cheque o código escrito ou volte para a categoria “Todos”.
        </p>
        <p class="mt-4 text-sm">
          <a
            href={`${prefix}catalogo.html`}
            class="inline-flex min-h-12 items-center text-green underline underline-offset-4"
          >
            Limpar filtros e ver tudo
          </a>
        </p>
      </div>

      <p class="mt-8 max-w-[62ch] text-sm text-paper-dim">
        Não achou o que precisa? Envie a lista pelo WhatsApp para confirmar
        disponibilidade e valor.
        <a href={linkWhatsApp()} class="ml-2 inline-flex min-h-12 items-center text-green underline underline-offset-4" data-whatsapp>
          Falar agora
        </a>
      </p>
    </div>
  </section>
</Base>
