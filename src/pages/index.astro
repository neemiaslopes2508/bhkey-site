---
import Base from '../layouts/Base.astro';
import Regua from '../components/Regua.astro';
import Icon from '../components/Icon.astro';
import ProdutoCard from '../components/ProdutoCard.astro';
import catalogo from '../data/catalogo.json';
import { prefixFor } from '../lib/paths.js';
import { linkWhatsApp, INSTAGRAM_URL, MAPA_URL } from '../config/site.js';

const prefix = prefixFor(Astro.url.pathname);
const total = catalogo.itens.length;

const categorias = catalogo.categorias.map((c) => ({
  ...c,
  total: catalogo.itens.filter((i) => i.categoria === c.slug).length,
  img: {
    'chaves-canivete': 'img/produtos/det-chave-2.jpg',
    'controles-remotos': 'img/produtos/perfil-remotos-pretos.jpg',
    'carcasas': 'img/produtos/det-estoque-1.jpg',
    'chaves-automotivas': 'img/produtos/det-pacotes.jpg',
  }[c.slug],
}));

const atalhos = [
  {
    icon: 'whatsapp-logo',
    titulo: 'WhatsApp',
    desc: 'Pedidos, disponibilidade e preço sob consulta.',
    href: linkWhatsApp(),
    externo: false,
  },
  {
    icon: 'instagram-logo',
    titulo: 'Instagram',
    desc: 'Novidades e fotos de estoque no @bhkey_distribuidora.',
    href: INSTAGRAM_URL,
    externo: true,
  },
  {
    icon: 'map-pin',
    titulo: 'Mapa',
    desc: 'Endereço a definir — abrir a busca da empresa no Google Maps.',
    href: MAPA_URL,
    externo: true,
  },
];

const confianca = [
  { icon: 'storefront', rotulo: 'Cobertura', texto: 'Atende todo o Brasil' },
  { icon: 'truck', rotulo: 'Envio', texto: 'Envio para todo o Brasil' },
  { icon: 'currency-circle-dollar', rotulo: 'Pagamento', texto: 'Pagamento via PIX' },
];

const destaques = catalogo.itens.slice(0, 6);
---
<Base
  title="BH Key Distribuidora — chaves, remotos e carcaças para chaveiro"
  description="Distribuidora de material para chaveiro: chaves canivete, controles remotos, carcaças e chaves automotivas. Catálogo com código e foto, pedidos pelo WhatsApp. Preço sob consulta."
>
  <!-- ── Hero ───────────────────────────────────────────────────────── -->
  <section class="border-b border-ink-line">
    <div class="shell grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-12 lg:gap-12 lg:py-20">
      <div class="lg:col-span-7" data-reveal>
        <Regua esquerda="Material para chaveiro" direita="B2B" />
        <h1 class="mt-6 text-[2rem] leading-[1.06] sm:text-[2.5rem] lg:text-[3.1rem]">
          Chaves, remotos e carcaças para chaveiros e revendas.
        </h1>
        <p class="mt-6 max-w-[58ch] text-base leading-relaxed text-paper/75 sm:text-lg">
          Catálogo técnico com código e foto de cada item. Monte a sua lista e envie
          pelo WhatsApp: disponibilidade e valor são confirmados no atendimento.
          Preços sob consulta.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`${prefix}catalogo.html`} class="btn btn--primaria">
            Ver catálogo
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={linkWhatsApp()} class="btn btn--secundaria" data-whatsapp>
            <Icon name="whatsapp-logo" size={18} />
            Pedir no WhatsApp
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <figure class="border border-ink-line bg-ink-soft">
          <img
            src={`${prefix}img/produtos/det-pacotes.jpg`}
            alt="Chaves e controles remotos embalados em pacotes plásticos sobre a bancada."
            width="600"
            height="600"
            fetchpriority="high"
            class="aspect-square w-full object-cover"
          />
          <figcaption class="label-caps border-t border-ink-line px-4 py-3 text-paper/60">
            Estoque em pacote · foto de amostra
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Atalhos ────────────────────────────────────────────────────── -->
  <section class="border-b border-ink-line" aria-labelledby="atalhos-titulo">
    <div class="shell py-10 sm:py-14">
      <Regua esquerda="Atalhos" direita="Três canais" />
      <h2 id="atalhos-titulo" class="sr-only">Atalhos de contato</h2>
      <ul class="mt-6 border border-ink-line">
        {atalhos.map((a, i) => (
          <li class:list={[i > 0 && 'border-t border-ink-line']}>
            <a
              href={a.href}
              class="flex items-center gap-4 bg-ink px-4 py-5 transition-colors hover:bg-ink-soft sm:px-6"
              {...(a.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="shrink-0 text-green" aria-hidden="true">
                <Icon name={a.icon} size={26} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-base font-semibold sm:text-lg">{a.titulo}</span>
                <span class="mt-0.5 block text-sm text-paper/70 sm:text-base">{a.desc}</span>
              </span>
              <span class="shrink-0 text-paper/50" aria-hidden="true">
                <Icon name="arrow-right" size={20} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Categorias ─────────────────────────────────────────────────── -->
  <section class="border-b border-ink-line" aria-labelledby="categorias-titulo">
    <div class="shell py-10 sm:py-14 lg:py-16">
      <Regua esquerda="Categorias" direita={`${categorias.length} linhas`} />
      <h2 id="categorias-titulo" class="mt-6 text-2xl sm:text-3xl lg:text-4xl">
        Quatro linhas para o seu balcão.
      </h2>
      <p class="mt-4 max-w-[56ch] text-paper/75">
        Cada linha abre no catálogo já filtrada, com código e foto de cada item.
      </p>

      <div class="mt-8 grid gap-px border border-ink-line bg-ink-line sm:grid-cols-2 lg:grid-cols-4">
        {categorias.map((c) => (
          <a href={`${prefix}catalogo.html?cat=${c.slug}`} class="group flex flex-col bg-ink">
            <span class="block overflow-hidden bg-ink-soft">
              <img
                src={`${prefix}${c.img}`}
                alt=""
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
              />
            </span>
            <span class="flex flex-1 flex-col gap-1.5 p-4">
              <span class="label-caps text-green">{c.total} itens</span>
              <span class="font-display text-lg font-semibold leading-snug transition-colors group-hover:text-green">
                {c.nome}
              </span>
              <span class="mt-2 inline-flex items-center gap-1.5 text-sm text-paper/70">
                Ver categoria
                <Icon name="arrow-right" size={16} />
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Oferta em destaque (seção em papel) ────────────────────────── -->
  <section class="border-b border-ink-line bg-paper text-ink" aria-labelledby="oferta-titulo">
    <div class="shell grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <Regua claro esquerda="Condição especial" direita="Preço sob consulta" />
        <h2 id="oferta-titulo" class="mt-6 text-2xl sm:text-3xl lg:text-4xl">
          A condição especial é combinada no atendimento.
        </h2>
        <p class="mt-5 max-w-[58ch] text-base text-ink/75 sm:text-lg">
          As condições em vigor são passadas pelo WhatsApp, com preço sob consulta e
          sujeitas à disponibilidade de estoque. Nada de preço publicado na página:
          o valor é confirmado no atendimento.
        </p>
        <a
          href={linkWhatsApp('Olá! Vim pelo site da BH Key Distribuidora e quero saber das condições em destaque.')}
          class="btn btn--primaria mt-8"
          data-whatsapp
        >
          <Icon name="whatsapp-logo" size={18} />
          Pedir a condição
        </a>
      </div>
      <div class="lg:col-span-5">
        <figure class="border border-ink/20 bg-paper-dim">
          <img
            src={`${prefix}img/produtos/grid-adesivos-marca.jpg`}
            alt="Folha de adesivos com a marca BH Key sobre a bancada."
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full object-cover"
          />
          <figcaption class="label-caps border-t border-ink/20 px-4 py-3 text-ink/60">
            Marca BH Key · foto de amostra
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── CTA catálogo ───────────────────────────────────────────────── -->
  <section class="border-b border-ink-line bg-ink-soft" aria-labelledby="cta-titulo">
    <div class="shell flex flex-col items-start gap-7 py-10 sm:flex-row sm:items-center sm:justify-between sm:py-14">
      <div>
        <Regua esquerda="Catálogo completo" direita={`${total} itens`} />
        <h2 id="cta-titulo" class="mt-5 text-2xl sm:text-3xl lg:text-4xl">
          Todo o catálogo em um lugar só.
        </h2>
        <p class="mt-4 max-w-[54ch] text-paper/75">
          Filtre por categoria, busque pelo código e monte a lista para enviar direto
          ao WhatsApp.
        </p>
      </div>
      <a href={`${prefix}catalogo.html`} class="btn btn--primaria shrink-0">
        Ver catálogo
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <!-- ── Faixa de confiança (estática) ──────────────────────────────── -->
  <section class="border-b border-ink-line" aria-label="Informações de atendimento">
    <div class="shell py-8">
      <ul class="grid gap-px border border-ink-line bg-ink-line sm:grid-cols-3">
        {confianca.map((c) => (
          <li class="flex items-start gap-3 bg-ink px-4 py-5">
            <span class="mt-0.5 shrink-0 text-green" aria-hidden="true">
              <Icon name={c.icon} size={20} />
            </span>
            <span class="min-w-0">
              <span class="label-caps block text-paper/60">{c.rotulo}</span>
              <span class="mt-1 block text-sm text-paper/85 sm:text-base">{c.texto}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Destaques (Embla carousel) ─────────────────────────────────── -->
  <section class="border-b border-ink-line" aria-labelledby="destaques-titulo">
    <div class="shell py-10 sm:py-14">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div class="min-w-0 flex-1">
          <Regua esquerda="Destaques" direita={`${destaques.length} itens`} />
          <h2 id="destaques-titulo" class="mt-5 text-2xl sm:text-3xl lg:text-4xl">
            Prontos para o balcão.
          </h2>
        </div>
        <div class="flex gap-2" data-embla-controls>
          <button
            type="button"
            data-embla-prev
            aria-label="Ver itens anteriores"
            class="flex h-11 w-11 items-center justify-center border border-ink-line text-paper transition-colors hover:border-green hover:text-green"
          >
            <Icon name="arrow-left" size={20} />
          </button>
          <button
            type="button"
            data-embla-next
            aria-label="Ver próximos itens"
            class="flex h-11 w-11 items-center justify-center border border-ink-line text-paper transition-colors hover:border-green hover:text-green"
          >
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>

      <div class="mt-8" data-embla>
        <div class="overflow-x-auto sem-barra" data-embla-viewport>
          <div class="flex" data-embla-container>
            {destaques.map((item) => (
              <div
                class="flex min-w-0 flex-[0_0_82%] pr-3 sm:flex-[0_0_47%] sm:pr-4 lg:flex-[0_0_31.5%] lg:pr-4"
                data-embla-slide
              >
                <ProdutoCard item={item} categorias={catalogo.categorias} borda />
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="label-caps mt-5 text-paper/60">
        Arraste para o lado ou use as setas · preços sob consulta
      </p>
    </div>
  </section>
</Base>
