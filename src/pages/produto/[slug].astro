---
import Base from '../../layouts/Base.astro';
import Regua from '../../components/Regua.astro';
import Icon from '../../components/Icon.astro';
import AvisoAmostra from '../../components/AvisoAmostra.astro';
import catalogo from '../../data/catalogo.json';
import { prefixFor } from '../../lib/paths.js';
import { linkWhatsApp, MENSAGEM_PRODUTO } from '../../config/site.js';

export function getStaticPaths() {
  return catalogo.itens.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const prefix = prefixFor(Astro.url.pathname);
const categoria = catalogo.categorias.find((c) => c.slug === item.categoria);
const mensagem = MENSAGEM_PRODUTO(item.codigo, item.nome);
const indice = catalogo.itens.findIndex((i) => i.slug === item.slug);
const proximo = catalogo.itens[(indice + 1) % catalogo.itens.length];
---
<Base title={`${item.codigo} · ${item.nome} — BH Key Distribuidora`} description={item.descricao}>
  <section class="border-b border-ink-line">
    <div class="shell py-10 sm:py-12">
      <nav aria-label="Trilha de navegação" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-paper-dim">
          <li>
            <a
              href={`${prefix}catalogo.html`}
              class="inline-flex min-h-12 items-center transition-colors duration-200 hover:text-paper"
            >Catálogo</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              href={`${prefix}catalogo.html?cat=${item.categoria}`}
              class="inline-flex min-h-12 items-center transition-colors duration-200 hover:text-paper"
            >{categoria ? categoria.nome : 'Item'}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="inline-flex min-h-12 items-center text-paper" aria-current="page">{item.codigo}</li>
        </ol>
      </nav>

      <Regua
        esquerda="Item do catálogo"
        direita={categoria ? categoria.nome : undefined}
      />

      <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Foto: card grafite 24 com ladrilho branco 16 dentro. -->
        <div class="lg:col-span-7">
          <figure class="foto foto--card">
            <span class="foto-tile block">
              <img
                src={`${prefix}${item.img}`}
                alt={item.nome}
                width="600"
                height="600"
                class="aspect-square w-full object-cover"
              />
            </span>
            <figcaption>{item.codigo} · foto de amostra</figcaption>
          </figure>
        </div>

        <div class="lg:col-span-5">
          <p class="label-caps text-green">{item.codigo}</p>
          <h1 class="mt-4 text-3xl sm:text-4xl">
            {item.nome}
          </h1>
          {categoria && (
            <p class="mt-4 text-sm text-paper-dim">
              <span class="label-caps mr-2">Categoria</span>
              <a
                href={`${prefix}catalogo.html?cat=${item.categoria}`}
                class="inline-flex min-h-12 items-center text-paper underline underline-offset-4 transition-colors duration-200 hover:text-green"
              >{categoria.nome}</a>
            </p>
          )}

          <p class="mt-4 max-w-[54ch] text-base text-paper-dim">
            {item.descricao}
          </p>

          <p class="mt-6 text-sm text-paper-dim">
            Preço sob consulta — valor confirmado no atendimento.
          </p>

          <div class="mt-6 max-w-[46rem]">
            <AvisoAmostra aviso={catalogo._aviso} />
          </div>

          <a
            href={linkWhatsApp(mensagem)}
            class="btn btn--primaria btn--block mt-6"
            data-whatsapp
          >
            <Icon name="whatsapp-logo" size={20} />
            Pedir no WhatsApp
          </a>
          <p class="mt-4 text-center text-sm text-paper-dim sm:text-left">
            A mensagem já vai com o código <span class="font-mono">{item.codigo}</span> e o nome do item.
          </p>

          <a
            href={`${prefix}catalogo.html`}
            class="mt-6 inline-flex min-h-12 items-center gap-2 text-sm text-paper-dim underline underline-offset-4 transition-colors duration-200 hover:text-paper"
          >
            <Icon name="arrow-left" size={16} />
            Voltar ao catálogo
          </a>
        </div>
      </div>

      <div class="mt-12 border-t border-ink-line pt-8">
        <Regua esquerda="Próximo item" direita={`${indice + 1} de ${catalogo.itens.length}`} />
        <a
          href={`${prefix}produto/${proximo.slug}.html`}
          class="card eleva group mt-6 flex items-center gap-4 p-4 sm:p-6"
        >
          <img
            src={`${prefix}${proximo.img}`}
            alt=""
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            class="h-16 w-16 shrink-0 rounded-sm object-cover"
          />
          <span class="min-w-0 flex-1">
            <span class="label-caps block text-green">{proximo.codigo}</span>
            <span class="mt-2 block text-base font-bold transition-colors duration-200 group-hover:text-green sm:text-xl">
              {proximo.nome}
            </span>
          </span>
          <span class="shrink-0 text-paper-dim" aria-hidden="true">
            <Icon name="arrow-right" size={20} />
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>
