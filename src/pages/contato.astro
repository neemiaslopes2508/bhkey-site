---
import Base from '../layouts/Base.astro';
import Regua from '../components/Regua.astro';
import Icon from '../components/Icon.astro';
import AvisoAmostra from '../components/AvisoAmostra.astro';
import { prefixFor } from '../lib/paths.js';
import {
  linkWhatsApp,
  INSTAGRAM_URL,
  INSTAGRAM_HANDLE,
  MAPA_URL,
  ENDERECO,
  HORARIO,
} from '../config/site.js';

const prefix = prefixFor(Astro.url.pathname);

const canais = [
  {
    icon: 'whatsapp-logo',
    rotulo: 'WhatsApp',
    valor: 'Pedidos e orçamento',
    nota: 'Mensagem pré-preenchida com o seu pedido.',
    href: linkWhatsApp(),
    externo: false,
    cta: 'Abrir conversa',
  },
  {
    icon: 'instagram-logo',
    rotulo: 'Instagram',
    valor: INSTAGRAM_HANDLE,
    nota: 'Fotos de estoque e novidades.',
    href: INSTAGRAM_URL,
    externo: true,
    cta: 'Ver perfil',
  },
  {
    icon: 'map-pin',
    rotulo: 'Endereço',
    valor: ENDERECO,
    nota: 'A busca abre o Google Maps pelo nome da empresa.',
    href: MAPA_URL,
    externo: true,
    cta: 'Abrir no mapa',
  },
  {
    icon: 'clock',
    rotulo: 'Horário',
    valor: HORARIO,
    nota: 'A confirmar com a BH Key.',
    href: null,
    externo: false,
    cta: null,
  },
];

const AVISO_ENDERECO =
  'Endereço e horário de funcionamento ainda não foram informados pela BH Key e aparecem como “A definir” até a confirmação.';
---
<Base
  title="Contato — BH Key Distribuidora"
  description="Fale com a BH Key Distribuidora pelo WhatsApp, Instagram ou Google Maps. Atendimento a chaveiros e revendas em todo o Brasil."
>
  <section class="border-b border-ink-line">
    <div class="shell py-10 sm:py-12">
      <Regua esquerda="Contato" direita="WhatsApp · Instagram · Mapa" />
      <h1 class="mt-6 max-w-[16ch] text-3xl sm:text-4xl lg:text-5xl">
        Fale com a BH Key.
      </h1>
      <p class="mt-4 max-w-[62ch] text-base text-paper-dim">
        O pedido é fechado pelo WhatsApp. Monte a lista no catálogo ou mande os
        códigos dos itens para confirmar disponibilidade e valor.
      </p>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <a href={linkWhatsApp()} class="btn btn--primaria" data-whatsapp>
          <Icon name="whatsapp-logo" size={20} />
          Pedir no WhatsApp
        </a>
        <a
          href={INSTAGRAM_URL}
          class="btn btn--secundaria"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="instagram-logo" size={20} />
          Instagram
        </a>
        <button type="button" class="btn btn--secundaria" data-lista-abrir>
          <Icon name="shopping-cart-simple" size={20} />
          Minha lista
        </button>
      </div>

      <!-- Canais: cards arredondados com respiro (v2 era matriz de fios). -->
      <div class="mt-10 grid gap-3 sm:grid-cols-2 sm:gap-4">
        {canais.map((c) => (
          <div class="card flex flex-col p-4 sm:p-6">
            <div class="flex items-center gap-2">
              <span class="shrink-0 text-green" aria-hidden="true">
                <Icon name={c.icon} size={22} />
              </span>
              <p class="label-caps text-paper-dim">{c.rotulo}</p>
            </div>
            <p class="mt-4 text-xl font-bold sm:text-2xl">
              {c.valor}
            </p>
            <p class="mt-2 max-w-[40ch] text-sm text-paper-dim">{c.nota}</p>
            {c.href && (
              <a
                href={c.href}
                class="mt-4 inline-flex min-h-12 items-center gap-2 self-start text-sm text-green underline underline-offset-4 transition-colors duration-200 hover:text-paper"
                {...(c.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {c.cta}
                <Icon name="arrow-right" size={14} />
              </a>
            )}
          </div>
        ))}
      </div>

      <div class="mt-8 max-w-[70ch]">
        <AvisoAmostra aviso={AVISO_ENDERECO} />
      </div>

      <p class="mt-8 text-sm text-paper-dim">
        Prefere escolher antes de chamar?
        <a
          href={`${prefix}catalogo.html`}
          class="ml-2 inline-flex min-h-12 items-center text-green underline underline-offset-4"
        >
          Abrir o catálogo
        </a>
      </p>
    </div>
  </section>
</Base>
